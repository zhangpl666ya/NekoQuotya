{
  "name": "nekoquotya",
  "private": true,
  "version": "1.0.0",
  "description": "NekoQuotya — an AI-girl desktop pet that tracks AI coding tools' token usage and quotas (data layer built on tokscale)",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "collect": "node src/collector/cli.ts",
    "collect:once": "node src/collector/cli.ts --once",
    "collect:resync": "node src/collector/cli.ts --resync",
    "pet": "node src/collector/cli.ts --pet",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tokscale": "4.20.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  },
  "productName": "NekoQuotya",
  "author": "zhangpl666ya",
  "build": {
    "appId": "io.github.zhangpl666ya.nekoquotya",
    "productName": "NekoQuotya",
    "copyright": "Copyright © 2026 zhangpl666ya",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/tokscale{,/**/*}",
      "!node_modules/@tokscale{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "node_modules/@tokscale/cli-win32-x64-msvc/bin/tokscale.exe",
        "to": "bin/tokscale.exe"
      },
      {
        "from": "packs",
        "to": "packs",
        "filter": [
          "**/*",
          "!*/data",
          "!*/data/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NekoQuotya",
      "artifactName": "NekoQuotya-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
